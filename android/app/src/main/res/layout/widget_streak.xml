<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_active"
    android:padding="12dp">

    <!-- Top Row: Brand (Left) + Nuestro Mundo Button (Right) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="🌸 Coliflor"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_world"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="🏠 Nuestro mundo"
            android:textColor="#E2FBE8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_active" />
    </RelativeLayout>

    <!-- Middle Row: Picaflor Mascot (Left) + Streak Info (Right) -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widget_bg_art"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_coliflor_active"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUESTRA RACHA"
                android:textColor="#A7F3D0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_streak_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 37 días"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="✓ Activa"
                android:textColor="#BBF7D0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/widget_pill_active" />

            <TextView
                android:id="@+id/widget_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="¡Otro día juntos! 💚"
                android:textColor="#D1FAE5"
                android:textSize="11sp"
                android:textStyle="italic" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Footer Bar: Next Day + Progress Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_footer_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_next_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Próximo día: Día 38"
            android:textColor="#E4E4E7"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_active" />
    </LinearLayout>

</LinearLayout>
