<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_streak_bg"
    android:padding="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_streak_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Racha: 0 días"
                android:textColor="#F2F2F7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Calculando..."
                android:textColor="#E5C573"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/widget_btn_action"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="ABRIR"
        android:textColor="#0D0E12"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/widget_btn_action_bg"
        android:stateListAnimator="@null" />

</LinearLayout>
